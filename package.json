{
  "name": "breeze-code",
  "private": true,
  "version": "0.5.2",
  "description": "A Light Weight Development Environment",
  "author": "itsphatto",
  "main": "src/main/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --check src/main/main.js && node --check src/main/preload.js && node --test \"test/**/*.test.js\"",
    "dist": "tsc && electron-builder --win --publish never",
    "predist": "node scripts/write-config.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsphatto/BreezeCode.git"
  },
  "build": {
    "appId": "com.breeze.ide",
    "productName": "Breeze Code",
    "publish": [
      {
        "provider": "github",
        "owner": "itsphatto",
        "repo": "BreezeCode",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "runtime/**",
      "package.json",
      "breeze.config.json"
    ],
    "asarUnpack": [
      "runtime/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/brand/Icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "morphicons": "^2.0.0"
  }
}
