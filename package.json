{
  "name": "breeze-code",
  "private": true,
  "version": "0.4.7",
  "description": "A Light Weight Development Environment",
  "author": "itsphatto",
  "main": "main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --check main.js && node --check preload.js && node --test \"test/**/*.test.js\"",
    "dist": "tsc && electron-builder --win --publish never",
    "predist": "node scripts/write-config.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsphatto/BreezeCode.git"
  },
  "build": {
    "appId": "com.breeze.ide",
    "productName": "Breeze Code",
    "publish": [
      {
        "provider": "github",
        "owner": "itsphatto",
        "repo": "BreezeCode",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "toolchains.js",
      "discord.js",
      "agentbrain.js",
      "guard.js",
      "breezescript.js",
      "breeze.html",
      "breeze.css",
      "runtime/**",
      "*.png",
      "assets/**",
      "package.json",
      "breeze.config.json"
    ],
    "asarUnpack": [
      "runtime/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "morphicons": "^2.0.0"
  }
}
